PREFIX biolink: <https://w3id.org/biolink/vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?label ?count
FROM <https://purl.humanatlas.io/graph/hra-kidney-disease-atlas>
WHERE {
  {
    SELECT ("# Nodes" as ?label) (COUNT(*) as ?count)
    WHERE {
      SELECT DISTINCT ?s 
      WHERE {
        ?s a biolink:NamedThing .
      }
    }
  }
  UNION
  {
    SELECT ("# Edges" as ?label) (COUNT(*) as ?count)
    WHERE {
      SELECT DISTINCT ?s 
      WHERE {
        ?s a rdf:Statement .
      }
    }
  }
  UNION
  {
    SELECT ("# Node Types" as ?label) (COUNT(*) as ?count)
    WHERE {
      SELECT DISTINCT ?class
      WHERE {
        ?s a biolink:NamedThing ;
          a ?class .
        FILTER(?class != biolink:NamedThing)
      }
    }
  }
  UNION
  {
    SELECT ("# Edge Types" as ?label) (COUNT(*) as ?count)
    WHERE {
      SELECT DISTINCT ?p
      WHERE {
        [] a rdf:Statement ;
          rdf:predicate ?p .
      }
    }
  }
}
ORDER BY DESC(?count)
